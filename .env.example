# Database
DATABASE_URL="postgresql://clipflow:clipflow@localhost:5432/clipflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Cloudflare R2 (S3-compatible)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# NextAuth
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# TikTok OAuth
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# OpenAI (for Whisper)
OPENAI_API_KEY=""

# yt-dlp path (if not in PATH, e.g. installed via pipx)
# YT_DLP_PATH="/home/tyler/.local/bin/yt-dlp"
