{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "baseUrl": ".",
    "customConditions": ["@clipflow/source"],
    "paths": {
      "@clipflow/shared": ["libs/shared/src/index.ts"],
      "@clipflow/db": ["libs/db/src/index.ts"],
      "@clipflow/video-processing": ["libs/video-processing/src/index.ts"]
    }
  }
}
