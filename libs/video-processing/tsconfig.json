{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "declaration": true,
    "baseUrl": ".",
    "esModuleInterop": true,
    "noUnusedLocals": false,
    "composite": false,
    "emitDeclarationOnly": false,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "@clipflow/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
